+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import type { CdpClient } from '../src/cdp/client.js';
+import { BridgeMessageOps } from '../src/bridge/message-ops.js';
+import { sendNativeStructuredMessage } from '../src/bridge/card-ops.js';
+import type { SendOptions, SendResult } from '../src/types/index.js';
+import {
+  createRendererRuntime,
+  FakeIpcRenderer,
+  runRendererScript,
+  type RendererSession,
+} from './helpers/renderer-runtime.js';
+
+const selfId = 5761;
+const sessions = [
+  {
+    name: '对方创建的私聊',
+    session: { id: 630541, sesUUID: '0-9047', type: 0, typeID: selfId, sesTypeID: 9047 },
+  },
+  {
+    name: '群聊',
+    session: { id: 630542, sesUUID: '1-92001', type: 1, typeID: selfId, sesTypeID: 92001 },
+  },
+];
+
+interface SendCase {
+  name: string;
+  contentType: number;
+  send: (
+    ops: BridgeMessageOps,
+    cdp: CdpClient,
+    options: SendOptions,
+    imagePath: string
+  ) => Promise<SendResult>;
+}
+
+const sendCases: SendCase[] = [
+  {
+    name: '文本',
+    contentType: 4,
+    send: (ops, _cdp, options) => ops.sendText('收件人回归', options),
+  },
+  {
+    name: '富文本',
+    contentType: 4,
+    send: (ops, _cdp, options) => ops.sendRichText('**收件人回归**', options),
+  },
+  {
+    name: '回复',
+    contentType: 13,
+    send: (ops, _cdp, options) => ops.sendReply({ messageId: '900' }, '回复内容', options),
+  },
+  {
+    name: '文件',
+    contentType: 3,
+    send: (ops, _cdp, options, imagePath) => ops.sendFile(imagePath, options),
+  },
+  {
+    name: '图片',
+    contentType: 4,
+    send: (ops, _cdp, options, imagePath) => ops.sendImage(imagePath, options),
+  },
+  {
+    name: '链接卡片',
+    contentType: 10,
+    send: (ops, _cdp, options) =>
+      ops.sendUrlCard(
+        {
+          title: '链接',
+          summary: '摘要',
+          linkUrl: 'https://example.com',
+        },
+        options
+      ),
+  },
+  {
+    name: '业务卡片',
+    contentType: 17,
+    send: (ops, _cdp, options) => ops.sendBizMessage({ title: '任务', content: '内容' }, options),
+  },
+  {
+    name: '应用卡片',
+    contentType: 8,
+    send: (ops, _cdp, options) => ops.sendAppMessage({ title: '应用', content: '内容' }, options),
+  },
+  {
+    name: '聊天记录卡片',
+    contentType: 15,
+    send: (ops, _cdp, options) =>
+      ops.sendChatRecord(
+        {
+          title: '聊天记录',
+          msgArray: [{ senderName: '原发送者', contentType: 0, content: '原内容' }],
+        },
+        options
+      ),
+  },
+  {
+    name: '已准备的原生语音',
+    contentType: 2,
+    send: (_ops, cdp, options) =>
+      sendNativeStructuredMessage(
+        cdp,
+        {
+          kind: 'voice',
+          contentType: 2,
+          content: { filepath: 'C:\\voice.amr', duration: 1 },
+        },
+        options
+      ),
+  },
+];
+
+function createNativeRuntime(session: RendererSession) {
+  const persisted: Array<Record<string, unknown>> = [];
+  const ipc = new FakeIpcRenderer(request => {
+    const [channel, payload] = request.args;
+    if (channel === 'sendingImgBeforeHandle') {
+      return { code: 0, data: { thumbPath: 'C:\\thumb.png', artworkPath: 'C:\\art.png' } };
+    }
+    if (channel === 'insertSendBefoeMsg') {
+      return { code: 0, data: { id: -22, msgIdx: '1.001' } };
+    }
+    if (channel === 'sendMessageNew') {
+      const message = payload as Record<string, unknown>;
+      if (message['receiver'] !== session.sesTypeID || message['sessionID'] !== session.id) {
+        return { code: 1, error: '发送目标与原生会话不一致' };
+      }
+      persisted.push({ ...message, id: 135100001, msgIdx: 10 });
+      return { code: 0 };
+    }
+    if (channel === 'getMessages') {
+      // 请求由本测试执行的 renderer 脚本构造。
+      const query = payload as { count: number };
+      if (query.count > 20) {
+        return { code: 1, message: 'Internal Server Error' };
+      }
+      return {
+        code: 0,
+        data: [
+          {
+            id: 900,
+            msgIdx: 9,
+            sessionID: session.id,
+            sender: 7722,
+            senderName: '原发送者',
+            contentType: 4,
+            content: { content: [{ type: 0, text: '原消息' }] },
+          },
+          ...persisted,
+        ],
+      };
+    }
+    return { code: 1, error: '未支持的测试 IPC' };
+  });
+  const runtime = createRendererRuntime({
+    ipc,
+    sessions: [session],
+    main: { userID: selfId, userName: '我', deviceID: 'test-device' },
+  });
+  const cdp = {
+    evaluate: (script: string) => runRendererScript(script, runtime.context),
+  } as unknown as CdpClient;
+  return { ipc, cdp, ops: new BridgeMessageOps(cdp) };
+}
+
+describe('原生发送收件人遵循 KK9 sesTypeID 语义', () => {
+  let tempDir: string;
+  let imagePath: string;
+
+  beforeAll(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kairo-native-recipient-'));
+    imagePath = path.join(tempDir, 'pixel.png');
+    fs.writeFileSync(
+      imagePath,
+      Buffer.from(
+        'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==',
+        'base64'
+      )
+    );
+  });
+
+  afterAll(() => {
+    if (tempDir) fs.rmSync(tempDir, { recursive: true, force: true });
+  });
+
+  describe.each(sessions)('$name', ({ session }) => {
+    it.each(sendCases)('$name 发送给 sesTypeID 而不是自己', async ({ contentType, send }) => {
+      const { ipc, cdp, ops } = createNativeRuntime(session);
+      const result = await send(ops, cdp, { targetSessionId: session.sesUUID }, imagePath);
+
+      for (const channel of ['insertSendBefoeMsg', 'sendMessageNew']) {
+        const requests = ipc.sent.filter(request => request.args[0] === channel);
+        expect(requests).toHaveLength(1);
+        expect(requests[0]?.args[1]).toMatchObject({
+          contentType,
+          sender: selfId,
+          receiver: session.sesTypeID,
+          sessionType: session.type,
+          sessionID: session.id,
+        });
+        if (contentType === 15) {
+          expect(requests[0]?.args[1]).toMatchObject({
+            content: {
+              typeID: session.sesTypeID,
+              senderID: selfId,
+              msgArray: [expect.objectContaining({ senderName: '原发送者' })],
+            },
+          });
+        }
+      }
+      expect(result).toMatchObject({ success: true, status: 'delivered', messageId: '135100001' });
+    });
+  });
+});
