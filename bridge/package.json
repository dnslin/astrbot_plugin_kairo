{
  "name": "@kairo/astrbot-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "prepare:driver": "node scripts/prepare-driver.mjs",
    "whoami": "node scripts/whoami.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "node --import tsx --test tests/attachments.test.ts tests/bridge.test.ts tests/protocol.test.ts tests/store.test.ts",
    "check": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@kairo/driver": "file:vendor/kairo-driver-source",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
